<!-- pages/index/index.wxml - 物品清单与统计看板 -->
<view class="container">
  <!-- 顶部微信原生搜索栏与扫码入口 -->
  <view class="search-bar-wrap flex-row">
    <view class="search-box flex-row">
      <icon type="search" size="18" color="#999" style="margin-right: 12rpx;"/>
      <input 
        class="search-input" 
        placeholder="搜索物品名、规格、标签、位置或条码" 
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
      />
      <icon wx:if="{{searchKeyword}}" type="clear" size="16" bindtap="onClearSearch"/>
    </view>
    <view class="scan-btn flex-center" bindtap="onScanCode">
      <text class="scan-icon">📷</text>
    </view>
  </view>

  <!-- 统计概览胶囊卡片 -->
  <view class="stats-card card">
    <view class="flex-between stats-header">
      <text class="stats-title">📊 资产全域概览</text>
      <text class="stats-badge">实时更新</text>
    </view>
    <view class="stats-grid">
      <view class="stat-item">
        <text class="stat-value text-bold">{{items.length}}</text>
        <text class="stat-label">收纳物品数</text>
      </view>
      <view class="stat-item">
        <text class="stat-value text-bold">¥{{totalValue}}</text>
        <text class="stat-label">估算总价值</text>
      </view>
      <view class="stat-item">
        <text class="stat-value text-bold stat-warning">{{expiringCount}}</text>
        <text class="stat-label">临期预警</text>
      </view>
      <view class="stat-item">
        <text class="stat-value text-bold">{{containersCount}}</text>
        <text class="stat-label">空间节点</text>
      </view>
    </view>
  </view>

  <!-- 分类筛选横向滑动 -->
  <scroll-view class="category-scroll" scroll-x enable-flex>
    <view 
      class="cat-chip {{selectedCategory === 'ALL' ? 'cat-chip-active' : ''}}" 
      bindtap="onSelectCategory" 
      data-category="ALL"
    >
      <text>全部 ({{items.length}})</text>
    </view>
    <view 
      wx:for="{{categories}}" 
      wx:key="id" 
      class="cat-chip {{selectedCategory === item.name ? 'cat-chip-active' : ''}}"
      bindtap="onSelectCategory"
      data-category="{{item.name}}"
    >
      <text>{{item.icon}} {{item.name}}</text>
    </view>
  </scroll-view>

  <!-- 物品列表 -->
  <view class="items-list-wrap">
    <view class="flex-between list-title-row">
      <text class="list-title">物品列表 ({{filteredItems.length}})</text>
      <text class="text-muted" bindtap="onToggleSort">排序: {{sortModeName}} ⇋</text>
    </view>

    <!-- 列表为空 -->
    <view wx:if="{{filteredItems.length === 0}}" class="empty-state">
      <text class="empty-icon">📦</text>
      <text class="empty-text">暂无收纳物品，点击下方按钮开始录入</text>
      <button class="btn-primary" style="width: 320rpx; margin-top: 24rpx;" bindtap="onQuickAdd">快速录入</button>
    </view>

    <!-- 物品卡片 -->
    <view 
      wx:for="{{filteredItems}}" 
      wx:key="id" 
      class="item-card card flex-between"
      bindtap="onItemClick"
      data-id="{{item.id}}"
    >
      <view class="item-info-col">
        <view class="flex-row item-name-row">
          <text class="item-name text-bold">{{item.name}}</text>
          <text class="qty-pill">x{{item.quantity}} {{item.unit || '个'}}</text>
        </view>
        <view class="item-meta-row flex-row">
          <text class="tag-badge tag-green">{{item.categoryName}}</text>
          <text wx:if="{{item.spec}}" class="tag-badge">{{item.spec}}</text>
          <text wx:if="{{item.brand}}" class="tag-badge">{{item.brand}}</text>
        </view>
        <view class="location-row flex-row">
          <text class="loc-pin">📍</text>
          <text class="loc-text">{{item.locationPath || item.suggestedLocation || '未分配位置'}}</text>
        </view>
      </view>

      <view class="item-action-col">
        <text wx:if="{{item.price > 0}}" class="item-price">¥{{item.price}}</text>
        <text wx:if="{{item.expiryStatus}}" class="tag-badge {{item.expiryStatus.status === 'EXPIRED' ? 'tag-red' : (item.expiryStatus.status === 'WARNING' ? 'tag-amber' : '')}}">
          {{item.expiryStatus.text}}
        </text>
        <text class="arrow-right">›</text>
      </view>
    </view>
  </view>

  <!-- 悬浮微信小程序标准新建按钮 -->
  <view class="fab-btn" bindtap="onQuickAdd">
    <text class="fab-icon">+</text>
  </view>
</view>
