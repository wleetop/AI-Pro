/* pages/index/index.wxss */
.search-bar-wrap {
  margin-bottom: 20rpx;
}

.search-box {
  flex: 1;
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.search-input {
  flex: 1;
  font-size: 26rpx;
}

.scan-btn {
  width: 76rpx;
  height: 76rpx;
  background: #07C160;
  border-radius: 38rpx;
  margin-left: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

.scan-icon {
  font-size: 32rpx;
  color: #fff;
}

/* 统计卡片 */
.stats-card {
  background: linear-gradient(135deg, #1C2430 0%, #2D3A4B 100%);
  color: #FFFFFF;
  border-radius: 24rpx;
}

.stats-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #E2E8F0;
}

.stats-badge {
  font-size: 20rpx;
  background: rgba(7, 193, 96, 0.25);
  color: #52C41A;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
  margin-top: 24rpx;
  text-align: center;
}

.stat-item {
  display: flex;
  flex-direction: column;
}

.stat-value {
  font-size: 36rpx;
  color: #FFFFFF;
}

.stat-warning {
  color: #FFA940;
}

.stat-label {
  font-size: 22rpx;
  color: #94A3B8;
  margin-top: 6rpx;
}

/* 分类滚动条 */
.category-scroll {
  white-space: nowrap;
  display: flex;
  flex-direction: row;
  margin-bottom: 24rpx;
  padding: 6rpx 0;
}

.cat-chip {
  display: inline-flex;
  padding: 12rpx 28rpx;
  background: #FFFFFF;
  border-radius: 30rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #4A5568;
  border: 1rpx solid #E2E8F0;
}

.cat-chip-active {
  background: #07C160;
  color: #FFFFFF;
  border-color: #07C160;
  font-weight: 600;
}

/* 物品列表 */
.list-title-row {
  margin-bottom: 16rpx;
}

.list-title {
  font-size: 30rpx;
  font-weight: 600;
}

.item-card {
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  transition: transform 0.1s ease;
}

.item-card:active {
  transform: scale(0.98);
}

.item-name {
  font-size: 30rpx;
  color: #1A202C;
}

.qty-pill {
  font-size: 22rpx;
  background: #E8F7EE;
  color: #07C160;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  margin-left: 12rpx;
  font-weight: 600;
}

.item-meta-row {
  margin-top: 10rpx;
  flex-wrap: wrap;
}

.location-row {
  margin-top: 8rpx;
}

.loc-pin {
  font-size: 22rpx;
  margin-right: 6rpx;
}

.loc-text {
  font-size: 24rpx;
  color: #718096;
}

.item-action-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
}

.item-price {
  font-size: 30rpx;
  font-weight: 600;
  color: #E53E3E;
  margin-bottom: 6rpx;
}

.arrow-right {
  font-size: 36rpx;
  color: #CBD5E0;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 96rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #A0AEC0;
}

/* 悬浮新建按钮 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 108rpx;
  height: 108rpx;
  background: linear-gradient(135deg, #07C160 0%, #059649 100%);
  border-radius: 54rpx;
  box-shadow: 0 10rpx 28rpx rgba(7, 193, 96, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}

.fab-icon {
  color: #FFFFFF;
  font-size: 64rpx;
  line-height: 1;
  font-weight: 300;
  margin-top: -6rpx;
}
