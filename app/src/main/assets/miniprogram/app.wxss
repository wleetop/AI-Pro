/** app.wxss - 微信官方小程序规范设计规范 **/
page {
  background-color: #F7F8FA;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

/* 微信主色调与按钮 */
.btn-primary {
  background: linear-gradient(135deg, #07C160 0%, #059649 100%);
  color: #FFFFFF;
  border-radius: 40rpx;
  font-weight: 600;
  font-size: 32rpx;
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-secondary {
  background: #E8F7EE;
  color: #07C160;
  border-radius: 40rpx;
  font-weight: 600;
  font-size: 30rpx;
  border: 2rpx solid rgba(7, 193, 96, 0.3);
}

/* 卡片容器 */
.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 微信轻量标签与状态 */
.tag-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background: #F0F2F5;
  color: #666666;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.tag-green {
  background: #E8F7EE;
  color: #07C160;
}

.tag-amber {
  background: #FEF3E6;
  color: #FA8C16;
}

.tag-red {
  background: #FFECE8;
  color: #F5222D;
}

/* 弹性布局快捷样式 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.text-muted {
  color: #8C8C8C;
  font-size: 24rpx;
}

.text-bold {
  font-weight: 600;
}
